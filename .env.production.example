# 🚀 Galaxy Wishlist - Production Environment Configuration
# Скопіюйте цей файл як .env на сервері та налаштуйте значення

# Application
APP_NAME="Galaxy Wishlist"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Kyiv
APP_URL=https://your-domain.com
APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

# Maintenance Mode Driver
APP_MAINTENANCE_DRIVER=file

# Database - MySQL Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galaxy_wishlist
DB_USERNAME=galaxy_user
DB_PASSWORD=your_secure_database_password_here

# Session Driver
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Driver
CACHE_STORE=database
CACHE_PREFIX=

# Queue Connection
QUEUE_CONNECTION=database

# Broadcasting
BROADCAST_CONNECTION=log

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Mail Configuration (налаштуйте для відправки листів)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Authentik OAuth Configuration
AUTHENTIK_BASE_URL=https://your-authentik-instance.com
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/callback"

# Admin User Credentials (для seeder)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Security Headers
SECURE_HEADERS=true

# Asset URL (якщо використовуєте CDN)
ASSET_URL="${APP_URL}"

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# Performance
OCTANE_SERVER=swoole
